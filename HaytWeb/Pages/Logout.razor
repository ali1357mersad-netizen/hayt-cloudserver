@page "/logout"

<PageTitle>خروج - حیات طیبه</PageTitle>

<div class="hayt-auth-page" dir="rtl">
    <section class="hayt-auth-shell hayt-auth-shell-single">
        <div class="hayt-auth-card hayt-auth-center">
            <div class="hayt-auth-logo mx-auto">ح</div>
            <h1>خروج از حساب</h1>
            <p class="hayt-auth-muted">
                این صفحه برای اتصال نهایی به سیستم خروج و پاک‌سازی Token آماده شده است.
            </p>

            <div class="alert alert-warning">
                منطق خروج واقعی در تکمیل فاز ۲ به AuthService متصل می‌شود.
            </div>

            <div class="hayt-auth-actions">
                <a class="btn btn-primary" href="/login">ورود مجدد</a>
                <a class="btn btn-outline-secondary" href="/">خانه</a>
            </div>
        </div>
    </section>
</div>
