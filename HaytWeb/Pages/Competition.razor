@page "/competition"

<PageTitle>مسابقه - حیات طیبه</PageTitle>

<div class="hayt-page" dir="rtl">
    <div class="hayt-page-header">
        <div>
            <div class="hayt-kicker">Competition</div>
            <h1>مسابقه</h1>
            <p>زیرساخت صفحه مسابقات، رتبه‌بندی و امتیازدهی کاربران.</p>
        </div>
    </div>

    <section class="hayt-stat-grid">
        <div class="hayt-stat-card">
            <span>مرحله</span>
            <strong>آماده‌سازی</strong>
            <small>Competition Core</small>
        </div>

        <div class="hayt-stat-card">
            <span>رتبه‌بندی</span>
            <strong>در انتظار</strong>
            <small>Leaderboard</small>
        </div>

        <div class="hayt-stat-card">
            <span>امتیازدهی</span>
            <strong>در انتظار</strong>
            <small>Score Engine</small>
        </div>
    </section>

    <section class="hayt-section-card">
        <h2>برنامه توسعه مسابقه</h2>
        <ul class="hayt-check-list">
            <li>تعریف سوالات و مراحل</li>
            <li>ثبت امتیاز کاربران</li>
            <li>نمایش جدول رتبه‌بندی</li>
            <li>اتصال به سیستم احراز هویت</li>
        </ul>
    </section>
</div>
