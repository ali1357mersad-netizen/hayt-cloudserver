<Window x:Class="Hayt.Views.AISettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات هوش مصنوعی"
        Width="860"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource HaytBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HaytSurfaceBrush}"
                BorderBrush="{DynamicResource HaytBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="🤖 تنظیمات مدل واقعی AI Tutor"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HaytTextBrush}"/>
                    <TextBlock Text="{Binding ModeText}"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource HaytPrimaryBrush}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Left"
                           Text="16-D5"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource HaytMutedTextBrush}"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Content="استفاده از مدل واقعی به جای پاسخ محلی"
                                  IsChecked="{Binding UseRealAI}"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource HaytTextBrush}"/>

                        <CheckBox Content="اگر اینترنت یا API خطا داشت، پاسخ محلی پشتیبان نمایش داده شود"
                                  IsChecked="{Binding AllowOfflineFallback}"
                                  Margin="0,10,0,0"
                                  Foreground="{DynamicResource HaytTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Provider:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Padding="8"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Base URL:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Padding="8"
                                 ToolTip="مثال: https://api.openai.com/v1/chat/completions"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Model:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Padding="8"
                                 ToolTip="مثال: gpt-4o-mini"/>

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="API Key:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <PasswordBox Grid.Row="6"
                                     Grid.Column="1"
                                     x:Name="ApiKeyBox"
                                     Height="34"
                                     Padding="8"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"/>

                        <TextBlock Grid.Row="8"
                                   Grid.Column="1"
                                   Text="نکته: فعلاً کلید در فایل JSON کاربر ذخیره می‌شود. در مرحله امنیت، SecureStorage/Encryption اضافه می‌کنیم."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource HaytMutedTextBrush}"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Timeout Seconds"
                                       FontSize="12"
                                       Foreground="{DynamicResource HaytMutedTextBrush}"/>
                            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Temperature"
                                       FontSize="12"
                                       Foreground="{DynamicResource HaytMutedTextBrush}"/>
                            <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Max Tokens"
                                       FontSize="12"
                                       Foreground="{DynamicResource HaytMutedTextBrush}"/>
                            <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     Padding="8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="170"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="تست اتصال"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HaytTextBrush}"/>

                        <TextBox Grid.Row="2"
                                 Text="{Binding TestQuestion, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"/>

                        <Button Grid.Row="4"
                                Content="ذخیره و تست"
                                Command="{Binding TestCommand}"
                                Padding="14,7"
                                HorizontalAlignment="Left"/>

                        <TextBox Grid.Row="6"
                                 Text="{Binding TestResult}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource HaytMutedTextBrush}"/>

            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="بارگذاری"
                        Command="{Binding LoadCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Content="ذخیره"
                        Command="{Binding SaveCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Content="پیش‌فرض"
                        Command="{Binding ResetCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Content="بستن"
                        Click="CloseButton_Click"
                        Padding="18,7"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>