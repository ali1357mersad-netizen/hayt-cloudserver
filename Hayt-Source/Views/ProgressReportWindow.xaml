<Window x:Class="Hayt.Views.ProgressReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="گزارش پیشرفت آموزشی"
        Height="760"
        Width="1050"
        MinHeight="620"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource HaytBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SummaryCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#172A2A"/>
            <Setter Property="BorderBrush"
                    Value="#315454"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="5"/>
        </Style>

        <Style x:Key="RefreshButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#2ECC71"/>
            <Setter Property="Foreground"
                    Value="#101820"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="18,9"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#58D68D"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#27AE60"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه گواهی؛ Style فقط یک‌بار اعمال می‌شود -->
        <Style x:Key="CertificateButtonStyle"
               TargetType="Button">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Setter Property="Background"
                    Value="#F2C94C"/>
            <Setter Property="Foreground"
                    Value="#102526"/>
            <Setter Property="BorderBrush"
                    Value="#FFE28A"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="20,10"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FFE07A"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5B830"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- عنوان و دکمه به‌روزرسانی -->
        <Grid Grid.Row="0"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="گزارش پیشرفت آموزشی"
                           Foreground="{DynamicResource HaytAccentBrush}"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="نمای کلی فعالیت‌ها، امتیازها و گواهی‌ها"
                           Foreground="{DynamicResource HaytMutedTextBrush}"
                           FontSize="13"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="↻ به‌روزرسانی گزارش"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource RefreshButtonStyle}"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- کارت‌های خلاصه -->
        <UniformGrid Grid.Row="1"
                     Columns="6"
                     Margin="-5,0,-5,12">

            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="کتاب‌ها"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding TotalBooksText}"
                               Foreground="{DynamicResource HaytOnPrimaryBrush}"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="درس‌های تکمیل‌شده"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding LessonsSummaryText}"
                               Foreground="{DynamicResource HaytOnPrimaryBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="پیشرفت کل"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding OverallPercentText}"
                               Foreground="{DynamicResource HaytAccentBrush}"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="زمان آموزش"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding TotalHoursText}"
                               Foreground="{DynamicResource HaytOnPrimaryBrush}"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="امتیاز و سطح"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding TotalXpText}"
                               Foreground="{DynamicResource HaytSuccessBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding OverallLevelTitle}"
                               Foreground="{DynamicResource HaytSuccessBrush}"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="گواهی‌ها"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding CertificatesText}"
                               Foreground="{DynamicResource HaytAccentBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- نوار پیشرفت کلی -->
        <Border Grid.Row="2"
                Background="{DynamicResource HaytSurfaceBrush}"
                BorderBrush="{DynamicResource HaytBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="میزان پیشرفت کل دوره‌ها"
                               Foreground="{DynamicResource HaytTextBrush}"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding OverallPercentText}"
                               Foreground="{DynamicResource HaytAccentBrush}"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"/>
                </Grid>

                <ProgressBar Grid.Row="1"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding OverallCompletionPercent, Mode=OneWay}"
                             Height="16"
                             Margin="0,10,0,0"
                             Foreground="{DynamicResource HaytSuccessBrush}"
                             Background="{DynamicResource HaytSurfaceBrush}"/>
            </Grid>
        </Border>

        <!-- وضعیت بارگذاری -->
        <Grid Grid.Row="3"
              Margin="0,0,0,12">

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource HaytTextBrush}"
                       FontSize="14"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ProgressBar Width="110"
                             Height="8"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource HaytSuccessBrush}"/>

                <TextBlock Text="در حال بارگذاری..."
                           Foreground="{DynamicResource HaytSuccessBrush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- فهرست گزارش کتاب‌ها -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource HaytSurfaceBrush}"
                                BorderBrush="{DynamicResource HaytSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding BookTitle}"
                                           Foreground="{DynamicResource HaytOnPrimaryBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding PercentText}"
                                           Foreground="{DynamicResource HaytAccentBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="20,0,0,0"/>

                                <ProgressBar Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Height="18"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding CompletionPercent, Mode=OneWay}"
                                             Foreground="{DynamicResource HaytSuccessBrush}"
                                             Background="{DynamicResource HaytSurfaceBrush}"
                                             Margin="0,14,0,10"/>

                                <WrapPanel Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Margin="0,8,0,0">

                                    <TextBlock Text="{Binding ProgressText}"
                                               Foreground="{DynamicResource HaytTextBrush}"
                                               FontSize="14"
                                               Margin="0,0,20,0"/>

                                    <TextBlock Text="{Binding HoursText}"
                                               Foreground="{DynamicResource HaytTextBrush}"
                                               FontSize="14"
                                               Margin="0,0,20,0"/>

                                    <TextBlock Text="{Binding XpText}"
                                               Foreground="{DynamicResource HaytTextBrush}"
                                               FontSize="14"
                                               Margin="0,0,20,0"/>

                                    <TextBlock Text="{Binding LevelTitle}"
                                               Foreground="{DynamicResource HaytSuccessBrush}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Margin="0,0,20,0"/>

                                    <TextBlock Text="{Binding CertificateStatus}"
                                               Foreground="{DynamicResource HaytAccentBrush}"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                </WrapPanel>

                                <TextBlock Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding CertificateHint}"
                                           Foreground="{DynamicResource HaytSuccessBrush}"
                                           FontSize="13"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="4"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding EncouragementMessage}"
                                           Foreground="{DynamicResource HaytAccentBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="5"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding CompletedLessonsText}"
                                           Foreground="{DynamicResource HaytSuccessBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>

                                                                <StackPanel Grid.Row="6"
                                            Grid.ColumnSpan="2"
                                            Margin="0,10,0,0">

                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="درس‌های باقی‌مانده:"
                                               Foreground="{DynamicResource HaytDangerBrush}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"/>

                                    <ItemsControl ItemsSource="{Binding RemainingLessonItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding DisplayTitle}"
                                                        Tag="{Binding LessonId}"
                                                        Click="LessonButton_Click"
                                                        Background="{DynamicResource HaytSurfaceBrush}"
                                                        Foreground="{DynamicResource HaytAccentBrush}"
                                                        BorderBrush="{DynamicResource HaytBorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="12,6"
                                                        Margin="0,4,8,4"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Cursor="Hand"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="▶ ادامه از درس بعدی"
                                            Tag="{Binding}"
                                            Click="ContinueButton_Click"
                                            Background="{DynamicResource HaytSuccessBrush}"
                                            Foreground="{DynamicResource HaytBackgroundBrush}"
                                            BorderThickness="0"
                                            Padding="16,8"
                                            Margin="0,10,0,0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            HorizontalAlignment="Right"/>
                                </StackPanel>

                                <!-- فقط یک Style روی دکمه اعمال شده است -->
                                <Button Grid.Row="7"
                                        Grid.ColumnSpan="2"
                                        Content="🏆 دریافت گواهی پایان کتاب"
                                        Tag="{Binding}"
                                        Click="CertificateButton_Click"
                                        Style="{StaticResource CertificateButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>

