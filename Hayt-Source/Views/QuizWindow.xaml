<Window x:Class="Hayt.Views.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="آزمون درس"
        Width="780"
        Height="640"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource HaytBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HaytOnPrimaryBrush}"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           Text="آزمون درس"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HaytTextBrush}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ProgressTextBlock"
                               Grid.Column="0"
                               Text="سؤال ۱ از ۱"
                               FontSize="14"
                               Foreground="{DynamicResource HaytMutedTextBrush}"/>

                    <TextBlock x:Name="AnsweredCountTextBlock"
                               Grid.Column="1"
                               Text="پاسخ‌داده‌شده: ۰"
                               FontSize="14"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               Margin="16,0,0,0"/>
                </Grid>

                <ProgressBar x:Name="QuizProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,12,0,0"
                             Foreground="{DynamicResource HaytPrimaryBrush}"
                             Background="{DynamicResource HaytBorderBrush}"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1"
                Background="{DynamicResource HaytOnPrimaryBrush}"
                CornerRadius="16"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="QuestionTextBlock"
                               TextWrapping="Wrap"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource HaytTextBrush}"
                               Margin="0,0,0,20"/>

                    <StackPanel x:Name="OptionsPanel">

                        <Border x:Name="OptionBorder0"
                                Background="{DynamicResource HaytSurfaceBrush}"
                                BorderBrush="{DynamicResource HaytBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,10"
                                MouseLeftButtonDown="OptionBorder0_MouseLeftButtonDown">
                            <RadioButton x:Name="OptionRadio0"
                                         GroupName="QuizOptions"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <Border x:Name="OptionBorder1"
                                Background="{DynamicResource HaytSurfaceBrush}"
                                BorderBrush="{DynamicResource HaytBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,10"
                                MouseLeftButtonDown="OptionBorder1_MouseLeftButtonDown">
                            <RadioButton x:Name="OptionRadio1"
                                         GroupName="QuizOptions"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <Border x:Name="OptionBorder2"
                                Background="{DynamicResource HaytSurfaceBrush}"
                                BorderBrush="{DynamicResource HaytBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,10"
                                MouseLeftButtonDown="OptionBorder2_MouseLeftButtonDown">
                            <RadioButton x:Name="OptionRadio2"
                                         GroupName="QuizOptions"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <Border x:Name="OptionBorder3"
                                Background="{DynamicResource HaytSurfaceBrush}"
                                BorderBrush="{DynamicResource HaytBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,10"
                                MouseLeftButtonDown="OptionBorder3_MouseLeftButtonDown">
                            <RadioButton x:Name="OptionRadio3"
                                         GroupName="QuizOptions"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                    </StackPanel>

                    <TextBlock x:Name="ResultTextBlock"
                               TextWrapping="Wrap"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,18,0,0"
                               Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource HaytOnPrimaryBrush}"
                CornerRadius="16"
                Padding="14"
                Margin="0,14,0,0">
            <DockPanel LastChildFill="False">

                <Button x:Name="CloseButton"
                        Content="بستن"
                        Width="95"
                        Height="38"
                        Margin="8,0,0,0"
                        Click="CloseButton_Click"/>

                <Button x:Name="PreviousButton"
                        Content="سؤال قبلی"
                        Width="110"
                        Height="38"
                        Margin="8,0,0,0"
                        Click="PreviousButton_Click"/>

                <Button x:Name="NextButton"
                        Content="سؤال بعدی"
                        Width="110"
                        Height="38"
                        Margin="8,0,0,0"
                        Click="NextButton_Click"/>

                <Button x:Name="SubmitButton"
                        Content="ثبت پاسخ"
                        Width="120"
                        Height="38"
                        Background="{DynamicResource HaytPrimaryBrush}"
                        Foreground="{DynamicResource HaytOnPrimaryBrush}"
                        Margin="8,0,0,0"
                        Click="SubmitButton_Click"/>

                <Button x:Name="FinishButton"
                        Content="پایان آزمون"
                        Width="120"
                        Height="38"
                        Background="{DynamicResource HaytSuccessBrush}"
                        Foreground="{DynamicResource HaytOnPrimaryBrush}"
                        Visibility="Collapsed"
                        Click="FinishButton_Click"/>

                <TextBlock x:Name="ScoreTextBlock"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource HaytTextBrush}"
                           Margin="20,0,0,0"/>

            </DockPanel>
        </Border>
    </Grid>
</Window>