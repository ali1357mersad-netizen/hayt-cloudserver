<Window x:Class="Hayt.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitleText}"
        Width="980"
        Height="760"
        MinWidth="850"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource HaytBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HaytSurfaceBrush}"
                BorderBrush="{DynamicResource HaytBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="🔐 لایسنس و فعال‌سازی"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HaytTextBrush}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,6,0,0"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HaytPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource HaytMutedTextBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Border Background="{DynamicResource HaytBackgroundBrush}"
                            BorderBrush="{DynamicResource HaytBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Plan"
                                       FontSize="10"
                                       Foreground="{DynamicResource HaytMutedTextBrush}"/>
                            <TextBlock Text="{Binding PlanText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HaytTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource HaytBackgroundBrush}"
                            BorderBrush="{DynamicResource HaytBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="Trial"
                                       FontSize="10"
                                       Foreground="{DynamicResource HaytMutedTextBrush}"/>
                            <TextBlock Text="{Binding TrialDaysLeft}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HaytPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Current state -->
                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="وضعیت:"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HaytPrimaryBrush}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="کاربر:"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding LicenseUserText}"
                                   Foreground="{DynamicResource HaytTextBrush}"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="انقضا:"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="{Binding ExpiryText}"
                                   Foreground="{DynamicResource HaytTextBrush}"/>

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="Machine ID:"
                                   Foreground="{DynamicResource HaytTextBrush}"/>
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Text="{Binding MachineId}"
                                 IsReadOnly="True"
                                 Height="34"
                                 Padding="8"/>
                    </Grid>
                </Border>

                <!-- Activation combined -->
                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="فعال‌سازی با متن کامل لایسنس"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HaytTextBrush}"/>

                        <TextBox Grid.Row="2"
                                 Text="{Binding CombinedLicenseText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"
                                 ToolTip="فرمت: PAYLOAD=... و SIGNATURE=... یا PAYLOAD::SIGNATURE"/>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button Content="فعال‌سازی"
                                    Command="{Binding ActivateCombinedCommand}"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="اعتبارسنجی"
                                    Command="{Binding ValidateCommand}"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="غیرفعال‌سازی"
                                    Command="{Binding DeactivateCommand}"
                                    Padding="14,7"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Activation parts -->
                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="فعال‌سازی با Payload و Signature جداگانه"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HaytTextBrush}"/>

                        <TextBox Grid.Row="2"
                                 Text="{Binding PayloadBase64, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="8"
                                 ToolTip="License JSON Base64"/>

                        <TextBox Grid.Row="4"
                                 Text="{Binding SignatureBase64, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="8"
                                 ToolTip="RSA Signature Base64"/>

                        <Button Grid.Row="6"
                                Content="فعال‌سازی با دو بخش"
                                Command="{Binding ActivatePartsCommand}"
                                Padding="14,7"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- Developer helper -->
                <Border Background="{DynamicResource HaytSurfaceBrush}"
                        BorderBrush="{DynamicResource HaytBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="130"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="ابزار کمکی توسعه‌دهنده - ساخت Payload خام"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HaytTextBrush}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding GeneratorUserName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     Padding="8"
                                     ToolTip="نام کاربر"/>

                            <TextBox Grid.Column="2"
                                     Text="{Binding GeneratorUserEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     Padding="8"
                                     ToolTip="ایمیل کاربر"/>
                        </Grid>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal">
                            <CheckBox Content="Bind به همین دستگاه"
                                      IsChecked="{Binding GeneratorBindToThisMachine}"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource HaytTextBrush}"
                                      Margin="0,0,16,0"/>

                            <TextBlock Text="روز اعتبار:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource HaytTextBrush}"
                                       Margin="0,0,8,0"/>

                            <TextBox Text="{Binding GeneratorValidDays, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"
                                     Height="34"
                                     Padding="8"
                                     Margin="0,0,12,0"/>

                            <Button Content="ساخت Payload خام"
                                    Command="{Binding GenerateUnsignedPayloadPreviewCommand}"
                                    Padding="14,7"/>
                        </StackPanel>

                        <TextBox Grid.Row="6"
                                 Text="{Binding UnsignedPayloadPreview}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Right"
                       Text="۱۷-A1: اعتبارسنجی آفلاین با امضای RSA - بدون تغییر دیتابیس"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource HaytMutedTextBrush}"/>

            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="بارگذاری"
                        Command="{Binding LoadCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Content="بررسی"
                        Command="{Binding ValidateCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Content="بستن"
                        Click="CloseButton_Click"
                        Padding="18,7"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>