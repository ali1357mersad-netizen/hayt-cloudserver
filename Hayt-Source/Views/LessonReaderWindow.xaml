<Window x:Class="Hayt.Views.LessonReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="درس"
        Height="690"
        Width="940"
        MinHeight="540"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource HaytBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#2ECC71"/>
            <Setter Property="Foreground"
                    Value="#101820"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="20,10"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#243A3A"/>
            <Setter Property="Foreground"
                    Value="#D6E4E5"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="20,10"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="MediaBadgeStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#172A2A"/>
            <Setter Property="BorderBrush"
                    Value="#315454"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="Margin"
                    Value="0,0,8,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LessonTitleText"
                   Grid.Row="0"
                   Text="در حال بارگذاری درس..."
                   Foreground="{DynamicResource HaytAccentBrush}"
                   FontSize="27"
                   FontWeight="Bold"
                   TextWrapping="Wrap"/>

        <TextBlock x:Name="LessonStatusText"
                   Grid.Row="1"
                   Foreground="{DynamicResource HaytSuccessBrush}"
                   FontSize="13"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        <WrapPanel Grid.Row="2"
                   Margin="0,14,0,0">

            <Border Style="{StaticResource MediaBadgeStyle}">
                <TextBlock x:Name="VideoStatusText"
                           Text="ویدئو: بررسی..."
                           Foreground="{DynamicResource HaytTextBrush}"
                           FontSize="13"/>
            </Border>

            <Border Style="{StaticResource MediaBadgeStyle}">
                <TextBlock x:Name="AudioStatusText"
                           Text="صوت: بررسی..."
                           Foreground="{DynamicResource HaytTextBrush}"
                           FontSize="13"/>
            </Border>

            <Border Style="{StaticResource MediaBadgeStyle}">
                <TextBlock x:Name="PdfStatusText"
                           Text="PDF: بررسی..."
                           Foreground="{DynamicResource HaytTextBrush}"
                           FontSize="13"/>
            </Border>
        </WrapPanel>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Background="{DynamicResource HaytSurfaceBrush}"
                BorderBrush="{DynamicResource HaytBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <TextBlock x:Name="LessonContentText"
                           Text="محتوای درس در حال بارگذاری است..."
                           Foreground="{DynamicResource HaytTextBrush}"
                           FontSize="15"
                           LineHeight="30"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="ExerciseButton"
                        Content="📝 شروع تمرین"
                        Click="ExerciseButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"/>

                <Button x:Name="MarkCompletedButton"
                        Content="✓ ثبت مطالعه بدون آزمون"
                        Click="MarkCompletedButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="بستن"
                    Click="CloseButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left"/>
        </Grid>
    </Grid>
</Window>