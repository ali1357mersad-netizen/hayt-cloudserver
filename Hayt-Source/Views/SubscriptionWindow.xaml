<Window x:Class="Hayt.Views.SubscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Premium و اشتراک"
        Width="760"
        Height="650"
        MinWidth="650"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FFF4F6FA">

    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF18212F"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#FFE1E6EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Background" Value="#FF1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFE8EEF7"/>
            <Setter Property="Foreground" Value="#FF26384A"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF162C46"
                Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Premium و اشتراک"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="مدیریت وضعیت لایسنس و دسترسی‌های حرفه‌ای"
                               Margin="0,7,0,0"
                               Foreground="#FFD7E5F4"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#33FFFFFF"
                        CornerRadius="18"
                        Padding="16,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="White"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <Border Style="{StaticResource Card}"
                        Background="#FFFFF8E1"
                        BorderBrush="#FFFFCA28">
                    <StackPanel>
                        <TextBlock Text="{Binding AccessText}"
                                   Style="{StaticResource TitleText}"
                                   FontSize="18"/>

                        <TextBlock Text="{Binding MessageText}"
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#FF5D4037"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="مشخصات اشتراک"
                                   Style="{StaticResource TitleText}"
                                   FontSize="17"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="پلن:"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding PlanText}"
                                       FontWeight="SemiBold"
                                       Margin="0,5"/>

                            <TextBlock Grid.Row="1"
                                       Text="تاریخ شروع:"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding StartDateText}"
                                       Margin="0,5"/>

                            <TextBlock Grid.Row="2"
                                       Text="تاریخ پایان:"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding ExpiryDateText}"
                                       Margin="0,5"/>

                            <TextBlock Grid.Row="3"
                                       Text="مهلت ارفاقی تا:"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding GraceDateText}"
                                       Margin="0,5"/>

                            <TextBlock Grid.Row="4"
                                       Text="زمان باقی‌مانده:"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{Binding RemainingText}"
                                       FontWeight="SemiBold"
                                       Margin="0,5"/>

                            <TextBlock Grid.Row="5"
                                       Text="آخرین بررسی:"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Text="{Binding CheckedAtText}"
                                       Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="اطلاعات فنی"
                                   Style="{StaticResource TitleText}"
                                   FontSize="17"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="شناسه لایسنس"
                                   Foreground="#FF64748B"/>

                        <TextBox Text="{Binding LicenseIdText}"
                                 Margin="0,5,0,12"
                                 IsReadOnly="True"
                                 Padding="8"/>

                        <TextBlock Text="Machine ID"
                                   Foreground="#FF64748B"/>

                        <TextBox Text="{Binding MachineIdText}"
                                 Margin="0,5,0,0"
                                 IsReadOnly="True"
                                 Padding="8"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Background="#FFFFEBEE"
                        BorderBrush="#FFEF9A9A"
                        Visibility="{Binding HasError,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFB71C1C"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#FFE1E6EF"
                BorderThickness="0,1,0,0"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Width="150"
                             Height="5"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button Grid.Column="1"
                        Content="بررسی مجدد"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0"/>

                <Button Grid.Column="2"
                        Content="فعال‌سازی لایسنس"
                        Command="{Binding ActivateLicenseCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding CanActivate,
                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>