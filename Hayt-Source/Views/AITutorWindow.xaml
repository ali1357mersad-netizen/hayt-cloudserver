<Window x:Class="Hayt.Views.AITutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding SessionTitle}"
        Width="900"
        Height="680"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource HaytBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>


    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- HaytPremiumUpgradeBanner -->
        <Border x:Name="HaytPremiumUpgradeBanner" Panel.ZIndex="1000" Visibility="{Binding IsUpgradeBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFF8E1" BorderBrush="#FFFFB300" BorderThickness="1" CornerRadius="10" Padding="14" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0" Background="#FFFFC107" CornerRadius="21">
                    <TextBlock Text="★" FontSize="23" Foreground="#FF4E342E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="فعال‌سازی مربی هوشمند Premium" FontSize="15" FontWeight="Bold" Foreground="#FF4E342E"/>
                    <TextBlock Text="{Binding UpgradeMessage}" Margin="0,4,12,0" TextWrapping="Wrap" Foreground="#FF5D4037"/>
                </StackPanel>
                <Button Grid.Column="2" Content="فعال‌سازی لایسنس" Command="{Binding ActivateLicenseCommand}" MinWidth="145" Height="38" Padding="14,5" Margin="10,0,0,0" VerticalAlignment="Center" Background="#FF1565C0" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>


        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HaytSurfaceBrush}"
                BorderBrush="{DynamicResource HaytBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="🤖 مربی هوشمند حیات"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HaytTextBrush}"/>
                    <TextBlock Text="{Binding SessionContextText}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource HaytPrimaryBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="پاک کردن گفتگو"
                            Command="{Binding ClearSessionCommand}"
                            Padding="10,5"
                            Margin="0,0,8,0"/>
                    <Button Content="خلاصه یادداشت‌ها"
                            Command="{Binding SummarizeNotesCommand}"
                            Padding="10,5"
                            Margin="0,0,8,0"/>
                    <Button Content="ساخت آزمون"
                            Command="{Binding GenerateQuizCommand}"
                            Padding="10,5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Messages -->
        <Border Grid.Row="2"
                Background="{DynamicResource HaytSurfaceBrush}"
                BorderBrush="{DynamicResource HaytBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource HaytBackgroundBrush}"
                                    BorderBrush="{DynamicResource HaytBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding RoleText}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource HaytPrimaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding SentAtText}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource HaytMutedTextBrush}"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Content}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{DynamicResource HaytTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Input -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                     Height="44"
                     Padding="10"
                     FontSize="13"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="سوال خود را بنویسید"/>

            <StackPanel Grid.Column="2">
                <Button Content="ارسال"
                        Command="{Binding AskCommand}"
                        IsEnabled="{Binding CanAsk}"
                        Padding="20,10"
                        Height="44"/>
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource HaytMutedTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>