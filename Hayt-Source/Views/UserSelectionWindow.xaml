<Window x:Class="Hayt.Views.UserSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب کاربر"
        Height="620"
        Width="840"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource HaytFontFamily}"
        Background="{DynamicResource HaytBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="#E1E8EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#147C78"/>
            <Setter Property="BorderBrush" Value="#147C78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#607D80"/>
            <Setter Property="BorderBrush" Value="#607D80"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HaytPrimaryBrush}"
                CornerRadius="22"
                Padding="24"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="انتخاب کاربر"
                               Foreground="{DynamicResource HaytOnPrimaryBrush}"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="برای جدا شدن پیشرفت، امتیاز و گواهی‌ها، کاربر مورد نظر را انتخاب کنید."
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="15"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="CurrentUserText"
                               Text="کاربر فعلی: default"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="13"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="86"
                        Height="86"
                        CornerRadius="43"
                        Background="{DynamicResource HaytPrimaryBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="👥"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Users list -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="کاربران موجود"
                               Foreground="{DynamicResource HaytTextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ListView x:Name="UsersList"
                              BorderThickness="0"
                              Background="Transparent"
                              MouseDoubleClick="UsersList_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource HaytBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource HaytTextBrush}"/>

                                        <TextBlock Text="{Binding Id}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HaytMutedTextBrush}"
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="{Binding LastLoginAt}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource HaytMutedTextBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Create user -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="ساخت کاربر جدید"
                               Foreground="{DynamicResource HaytTextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="نام نمایشی"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="13"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="DisplayNameBox"
                             Height="38"
                             FontSize="15"
                             Padding="8"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="شناسه کاربر به‌صورت خودکار ساخته می‌شود."
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Button Content="➕ ساخت کاربر"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="CreateUserButton_Click"/>

                    <Separator Margin="0,20"/>

                    <TextBlock Text="راهنما"
                               Foreground="{DynamicResource HaytMutedTextBrush}"
                               FontSize="13"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="با انتخاب هر کاربر، پیشرفت درس‌ها، امتیازها و گواهی‌های او جداگانه نمایش داده می‌شود."
                               TextWrapping="Wrap"
                               LineHeight="25"
                               Foreground="{DynamicResource HaytTextBrush}"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2"
                   Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Right"
                       Text="آماده"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource HaytMutedTextBrush}"
                       FontSize="13"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="انتخاب کاربر"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SelectUserButton_Click"/>

                <Button Content="به‌روزرسانی"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>

                <Button Content="بستن"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>