<Window x:Class="Hayt.MainWindow" x:Name="RootWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hayt" Title="اندیشکده حیات طیبه" Width="1400" Height="860" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{DynamicResource HaytBackgroundBrush}" Foreground="{DynamicResource HaytTextBrush}" FontFamily="{DynamicResource HaytFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ======================================================
             ابزارها
             ====================================================== -->

        <local:CategoryBooksConverter x:Key="CategoryBooksConverter" />

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="26" ShadowDepth="5" Direction="270" Color="#24000000" Opacity="0.34" />

        <DropShadowEffect x:Key="PopupShadow" BlurRadius="38" ShadowDepth="10" Direction="270" Color="#50000000" Opacity="0.45" />

        <DropShadowEffect x:Key="AccentGlow" BlurRadius="20" ShadowDepth="0" Color="#5514B8A6" Opacity="0.72" />

        <LinearGradientBrush x:Key="MainHeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#071F20" Offset="0" />
            <GradientStop Color="#0B3D3D" Offset="0.48" />
            <GradientStop Color="#0D756D" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryActionGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#12B8A6" Offset="0" />
            <GradientStop Color="#0B7E78" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldActionGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8D36A" Offset="0" />
            <GradientStop Color="#E9A72E" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerActionGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F87171" Offset="0" />
            <GradientStop Color="#C2413A" Offset="1" />
        </LinearGradientBrush>

        <!-- ======================================================
             کارت‌ها
             ====================================================== -->

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HaytSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HaytBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>

        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HaytBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HaytBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- ======================================================
             متن‌ها
             ====================================================== -->

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HaytTextBrush}" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HaytTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HaytMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HaytMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="3,8,3,4" />
        </Style>

        <!-- ======================================================
             دکمه مدرن با انیمیشن Hover
             ====================================================== -->

        <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource PrimaryActionGradient}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HaytPrimaryLightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border x:Name="ButtonShadow" Margin="2,5,2,0" CornerRadius="12" Background="#25000000" />
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ButtonBorder" Property="Effect" Value="{StaticResource AccentGlow}" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-2" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.18" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonShadow" Property="Opacity" Value="0.35" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="1" Duration="0:0:0.06" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource HaytAccentLightBrush}" />
                        <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource HaytSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource HaytTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HaytBorderBrush}" />
        </Style>

        <Style x:Key="GoldButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource GoldActionGradient}" />
            <Setter Property="Foreground" Value="#2B2414" />
            <Setter Property="BorderBrush" Value="#FFE49A" />
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="MinWidth" Value="125" />
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style x:Key="SidebarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="13,8" />
        </Style>

        <!-- ======================================================
             ComboBox
             ====================================================== -->

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource HaytTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource HaytBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HaytBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ======================================================
             ListBox
             ====================================================== -->

        <Style x:Key="QuestionItemStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                <Border x:Name="QuestionContainer" Margin="0" Padding="12" Background="{DynamicResource HaytBackgroundBrush}" BorderBrush="{DynamicResource HaytBorderBrush}" BorderThickness="1" CornerRadius="13" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" />
                    </Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="QuestionContainer" Property="BorderBrush" Value="{DynamicResource HaytAccentBrush}" />
                        <Setter TargetName="QuestionContainer" Property="Background" Value="{DynamicResource HaytSurfaceBrush}" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="QuestionContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-3" Duration="0:0:0.14" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="QuestionContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="QuestionContainer" Property="Background" Value="{DynamicResource HaytPrimaryBrush}" />
                        <Setter TargetName="QuestionContainer" Property="BorderBrush" Value="{DynamicResource HaytAccentLightBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="QuestionContainer" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

        <!-- ======================================================
             درخت آموزشی
             ====================================================== -->

        <Style x:Key="EducationTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />

            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EducationTreeItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="MouseEnter" Handler="EducationTreeItem_MouseEnter" />
            <EventSetter Event="Selected" Handler="EducationTreeItem_Selected" />
        </Style>

        <DataTemplate x:Key="LessonTemplate">
            <Border x:Name="LessonBorder" Margin="22,2,2,2" Padding="10,7" MinHeight="34" CornerRadius="10" Background="{DynamicResource HaytBackgroundBrush}" BorderBrush="{DynamicResource HaytBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="27" Height="27" Margin="0,0,8,0" CornerRadius="8" Background="{DynamicResource HaytSurfaceBrush}">
                        <TextBlock Text="◈" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HaytAccentBrush}" FontSize="12" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource HaytTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="LessonBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="LessonBorder" Property="BorderBrush" Value="{DynamicResource HaytAccentBrush}" />
                    <Setter TargetName="LessonBorder" Property="Background" Value="{DynamicResource HaytSurfaceBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="ChapterTemplate" ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource LessonTemplate}">
            <Border x:Name="ChapterBorder" Margin="16,2,2,2" Padding="10,7" MinHeight="36" CornerRadius="11" Background="{DynamicResource HaytBackgroundBrush}" BorderBrush="{DynamicResource HaytBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="▤" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource HaytAccentBrush}" FontSize="15" />

                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource HaytTextBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <HierarchicalDataTemplate.Triggers>
                <Trigger SourceName="ChapterBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ChapterBorder" Property="BorderBrush" Value="{DynamicResource HaytAccentBrush}" />
                    <Setter TargetName="ChapterBorder" Property="Background" Value="{DynamicResource HaytSurfaceBrush}" />
                </Trigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="SectionTemplate" ItemsSource="{Binding Chapters}" ItemTemplate="{StaticResource ChapterTemplate}">
            <Border x:Name="SectionBorder" Margin="10,2,2,2" Padding="10,8" MinHeight="38" CornerRadius="12" Background="{DynamicResource HaytBackgroundBrush}" BorderBrush="{DynamicResource HaytBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="▰" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource HaytPrimaryLightBrush}" FontSize="14" />

                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource HaytTextBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <HierarchicalDataTemplate.Triggers>
                <Trigger SourceName="SectionBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="SectionBorder" Property="BorderBrush" Value="{DynamicResource HaytAccentBrush}" />
                    <Setter TargetName="SectionBorder" Property="Background" Value="{DynamicResource HaytSurfaceBrush}" />
                </Trigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="BookTreeTemplate" ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}">
            <Border x:Name="BookBorder" Margin="4,3,2,3" Padding="11,9" MinHeight="42" CornerRadius="13" Background="{DynamicResource HaytBackgroundBrush}" BorderBrush="{DynamicResource HaytBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" Margin="0,0,9,0" CornerRadius="9" Background="{DynamicResource HaytSurfaceBrush}">
                        <TextBlock Text="▥" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HaytAccentBrush}" FontSize="15" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource HaytTextBrush}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <HierarchicalDataTemplate.Triggers>
                <Trigger SourceName="BookBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="BookBorder" Property="BorderBrush" Value="{DynamicResource HaytAccentBrush}" />
                    <Setter TargetName="BookBorder" Property="Background" Value="{DynamicResource HaytSurfaceBrush}" />
                </Trigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="CategoryTreeTemplate" ItemTemplate="{StaticResource BookTreeTemplate}">
            <HierarchicalDataTemplate.ItemsSource>
                <MultiBinding Converter="{StaticResource CategoryBooksConverter}">
                    <Binding />
                    <Binding Path="DataContext.Books" RelativeSource="{RelativeSource AncestorType={x:Type TreeView}}" />
                </MultiBinding>
            </HierarchicalDataTemplate.ItemsSource>

            <Border x:Name="CategoryBorder" Margin="0,4" Padding="12,10" MinHeight="54" CornerRadius="15" Background="{DynamicResource HaytSurfaceBrush}" BorderBrush="{DynamicResource HaytBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" Margin="0,0,10,0" CornerRadius="12" Background="{DynamicResource HaytBackgroundBrush}">
                        <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource HaytTextBrush}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding Description}" Margin="0,3,0,0" MaxHeight="32" Foreground="{DynamicResource HaytMutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="‹" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HaytAccentBrush}" FontSize="22" FontWeight="Light" />
                </Grid>
            </Border>

            <HierarchicalDataTemplate.Triggers>
                <Trigger SourceName="CategoryBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CategoryBorder" Property="BorderBrush" Value="{DynamicResource HaytAccentBrush}" />
                    <Setter TargetName="CategoryBorder" Property="Effect" Value="{StaticResource AccentGlow}" />
                </Trigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

    </Window.Resources>

    <!-- ==========================================================
         ساختار اصلی
         ========================================================== -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <!-- هاله‌های تزئینی پس‌زمینه -->

        <Ellipse Grid.RowSpan="3" Width="470" Height="470" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-230,0,0" Fill="{DynamicResource HaytAccentBrush}" Opacity="0.055" IsHitTestVisible="False" />

        <Ellipse Grid.RowSpan="3" Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-190,-210" Fill="{DynamicResource HaytPrimaryLightBrush}" Opacity="0.05" IsHitTestVisible="False" />

        <!-- ======================================================
             سربرگ
             ====================================================== -->

        
        <!-- ======================================================
             دکمه منوی اصلی
             ====================================================== -->

        <Button x:Name="MainMenuButton" Content="☰  منو" Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" Padding="18,10" FontSize="15" FontWeight="SemiBold" Background="{DynamicResource HaytSurfaceBrush}" Foreground="{DynamicResource HaytTextBrush}" BorderBrush="{DynamicResource HaytBorderBrush}" BorderThickness="1" Cursor="Hand" Click="MainMenuButton_Click" ToolTip="باز و بسته کردن منوی اصلی">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HaytAccentBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HaytAccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button><Border Grid.Row="0" Margin="14,12,14,0" Padding="20,10" CornerRadius="22" Background="{StaticResource MainHeaderGradient}" Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" Margin="0,0,12,0" CornerRadius="15" Background="#20FFFFFF" BorderBrush="#36FFFFFF" BorderThickness="1">
                            <TextBlock Text="ح" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold" />
                        </Border>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                            <TextBlock Text="اندیشکده حیات طیبه" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />

                            <TextBlock Text="کانون فرهنگی تبلیغی مرصاد قم" Margin="0,3,0,0" Foreground="#CDE7E4" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Margin="4" Padding="12,7" CornerRadius="13" Background="#16FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#4ADE80" />
                            <TextBlock Text="{Binding OfflineStatus}" VerticalAlignment="Center" Foreground="#E4F3F1" FontSize="12" />
                        </StackPanel>
                    </Border>

