<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Hayt Theme - Phase 3 - Modern & Vibrant
         پالت رنگی: سبز زمردی، فیروزه‌ای، طلایی، کرم، سفید
         ============================================================ -->

    <!-- ===== فونت ===== -->
    <FontFamily x:Key="HaytFontFamily">pack://application:,,,/Assets/Fonts/#Vazirmatn, Vazirmatn, Vazir, IRANSans, Tahoma, Segoe UI</FontFamily>

    <!-- ===== رنگ‌ها ===== -->
    <Color x:Key="HaytPrimaryColor">#0B3D2E</Color>
    <Color x:Key="HaytPrimaryDarkColor">#072A20</Color>
    <Color x:Key="HaytPrimaryLightColor">#145A44</Color>
    <Color x:Key="HaytAccentColor">#14B8A6</Color>
    <Color x:Key="HaytAccentLightColor">#5EEAD4</Color>
    <Color x:Key="HaytGoldColor">#F5B841</Color>
    <Color x:Key="HaytGoldLightColor">#FCD34D</Color>
    <Color x:Key="HaytCreamColor">#FDF8F0</Color>
    <Color x:Key="HaytBackgroundColor">#F4F7F5</Color>
    <Color x:Key="HaytSurfaceColor">#FFFFFF</Color>
    <Color x:Key="HaytBorderColor">#DCE8E2</Color>
    <Color x:Key="HaytTextColor">#12332B</Color>
    <Color x:Key="HaytMutedTextColor">#5E7A70</Color>
    <Color x:Key="HaytDangerColor">#DC2626</Color>
    <Color x:Key="HaytSuccessColor">#10B981</Color>
    <Color x:Key="HaytWarningColor">#F59E0B</Color>

    <!-- ===== براش‌ها ===== -->
    <SolidColorBrush x:Key="HaytPrimaryBrush" Color="{StaticResource HaytPrimaryColor}"/>
    <SolidColorBrush x:Key="HaytPrimaryDarkBrush" Color="{StaticResource HaytPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="HaytPrimaryLightBrush" Color="{StaticResource HaytPrimaryLightColor}"/>
    <SolidColorBrush x:Key="HaytAccentBrush" Color="{StaticResource HaytAccentColor}"/>
    <SolidColorBrush x:Key="HaytAccentLightBrush" Color="{StaticResource HaytAccentLightColor}"/>
    <SolidColorBrush x:Key="HaytGoldBrush" Color="{StaticResource HaytGoldColor}"/>
    <SolidColorBrush x:Key="HaytGoldLightBrush" Color="{StaticResource HaytGoldLightColor}"/>
    <SolidColorBrush x:Key="HaytCreamBrush" Color="{StaticResource HaytCreamColor}"/>
    <SolidColorBrush x:Key="HaytBackgroundBrush" Color="{StaticResource HaytBackgroundColor}"/>
    <SolidColorBrush x:Key="HaytSurfaceBrush" Color="{StaticResource HaytSurfaceColor}"/>
    <SolidColorBrush x:Key="HaytBorderBrush" Color="{StaticResource HaytBorderColor}"/>
    <SolidColorBrush x:Key="HaytTextBrush" Color="{StaticResource HaytTextColor}"/>
    <SolidColorBrush x:Key="HaytMutedTextBrush" Color="{StaticResource HaytMutedTextColor}"/>
    <SolidColorBrush x:Key="HaytDangerBrush" Color="{StaticResource HaytDangerColor}"/>
    <SolidColorBrush x:Key="HaytSuccessBrush" Color="{StaticResource HaytSuccessColor}"/>
    <SolidColorBrush x:Key="HaytWarningBrush" Color="{StaticResource HaytWarningColor}"/>
    <SolidColorBrush x:Key="HaytOnPrimaryBrush" Color="#FFFFFF"/>

    <!-- ===== گرادیان‌ها ===== -->
    <LinearGradientBrush x:Key="HaytHeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B3D2E" Offset="0"/>
        <GradientStop Color="#145A44" Offset="0.55"/>
        <GradientStop Color="#0E7C6B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HaytSidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#072A20" Offset="0"/>
        <GradientStop Color="#0B3D2E" Offset="0.6"/>
        <GradientStop Color="#0E7C6B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HaytGoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5B841" Offset="0"/>
        <GradientStop Color="#FCD34D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HaytButtonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#14B8A6" Offset="0"/>
        <GradientStop Color="#0E7C6B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HaytCreamGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDF8F0" Offset="0"/>
        <GradientStop Color="#F7EFE0" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== فاصله‌ها ===== -->
    <Thickness x:Key="HaytPageMargin">22</Thickness>
    <Thickness x:Key="HaytCardPadding">18</Thickness>
    <Thickness x:Key="HaytControlMargin">6</Thickness>
    <Thickness x:Key="HaytButtonPadding">16,8</Thickness>

    <!-- ===== استایل سراسری ===== -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource HaytFontFamily}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HaytFontFamily}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ===== تایپوگرافی ===== -->
    <Style x:Key="HaytTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HaytTextBrush}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="HaytSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HaytMutedTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="HaytSmallTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HaytMutedTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ===== کارت ===== -->
    <Style x:Key="HaytCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HaytSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="{StaticResource HaytCardPadding}"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource HaytBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="HaytHeaderCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HaytHeaderGradient}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="HaytCreamCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HaytCreamGradient}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="{StaticResource HaytCardPadding}"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource HaytBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===== دکمه ===== -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource HaytFontFamily}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="{StaticResource HaytButtonPadding}"/>
        <Setter Property="Margin" Value="{StaticResource HaytControlMargin}"/>
        <Setter Property="Background" Value="{StaticResource HaytButtonGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HaytSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource HaytMutedTextBrush}"/>
    </Style>

    <Style x:Key="HaytGoldButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource HaytGoldGradient}"/>
        <Setter Property="Foreground" Value="#26322E"/>
    </Style>

    <Style x:Key="HaytDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource HaytDangerBrush}"/>
    </Style>

    <Style x:Key="HaytOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HaytPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HaytPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- ===== ورودی متن ===== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource HaytFontFamily}"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource HaytTextBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource HaytBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource HaytFontFamily}"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource HaytTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HaytBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===== ProgressBar (باگ رفع شد) ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource HaytAccentBrush}"/>
        <Setter Property="Background" Value="#EAF2F3"/>
        <Setter Property="BorderBrush" Value="{StaticResource HaytBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===== ListView ===== -->
    <Style TargetType="ListView">
        <Setter Property="BorderBrush" Value="{StaticResource HaytBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource HaytTextBrush}"/>
    </Style>

    <!-- ===== ScrollViewer ===== -->
    <Style TargetType="ScrollViewer">
        <Setter Property="CanContentScroll" Value="True"/>
    </Style>

</ResourceDictionary>
